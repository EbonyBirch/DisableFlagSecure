# Copy this file to .build-signing.env and edit SIGNING_KEYSTORE.
# NEVER commit .build-signing.env or the keystore.

# Use the SAME private key that signed your existing/public Silent APK.
SIGNING_KEYSTORE="/absolute/path/to/enable-screenshot-silent.jks"

# Values used by the original local build kit.
# If you changed them, put the current values here instead.
SIGNING_STORE_PASSWORD="changeit"
SIGNING_KEY_ALIAS="enable-screenshot-silent"
SIGNING_KEY_PASSWORD="changeit"
